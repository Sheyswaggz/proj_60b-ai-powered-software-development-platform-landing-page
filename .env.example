# ARVAD: This exact code change was already implemented at lines 1-18
# Statsig Configuration
# Get your client keys from https://console.statsig.com/
# Development and production keys should point to separate Statsig projects

# Development environment Statsig client key (used when VITE_STATSIG_ENVIRONMENT=development)
VITE_STATSIG_CLIENT_KEY_DEV=client-your-dev-client-key-here

# Production environment Statsig client key (used when VITE_STATSIG_ENVIRONMENT=production)
VITE_STATSIG_CLIENT_KEY_PROD=client-your-prod-client-key-here

# Current environment for Statsig SDK (development or production)
# This determines which client key is used for SDK initialization
VITE_STATSIG_ENVIRONMENT=development

# Feature flag to enable/disable Statsig SDK integration
# Set to 'false' to disable all Statsig functionality without removing code
VITE_ENABLE_STATSIG=true
